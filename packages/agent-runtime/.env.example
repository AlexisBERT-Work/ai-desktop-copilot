# CatDesk — agent runtime : secrets locaux (copier en `.env`, gitignoré).
# L'agent charge ce `.env` depuis son dossier (packages/agent-runtime) au démarrage.

# Webhook Discord (optionnel) — revue de presse tech / send_webhook_message
DISCORD_WEBHOOK_URL=

# ─── Revue de presse quotidienne → dailys (tri modèles 2026-07-20) ───
# ACTIVE PAR DÉFAUT sur tout poste (publication ouverte : session anonyme +
# RPC Postgres `publish_daily_if_missing`, URL/clé anon publiques déjà en
# défaut dans le code — rien à renseigner ici pour que ça marche).
# Décommente pour désactiver explicitement sur CE poste :
# CATDESK_PRESS_DIGEST=0

# SUPABASE_URL / SUPABASE_ANON_KEY : à ne renseigner QUE pour pointer sur un
# autre projet Supabase que celui par défaut (dev/test).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Identifiants ADMIN — optionnels : n'activent que les extras réservés à
# l'admin (journaux personnalisés « press_feeds », miroir Discord ci-dessous).
# Le lot standard fonctionne déjà sans eux.
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=

# Optionnels :
CATDESK_PRESS_MODE=both           # journal = 1 daily/journal · topic = trié par sujet · both = les deux
CATDESK_PRESS_TOPIC_LIMIT=40      # nb d'articles les plus importants soumis au tri par sujet (plafond 200)
CATDESK_PRESS_HOUR=7              # heure locale de publication (0-23)
CATDESK_PRESS_RUN_ON_START=0      # 1 = publie aussi au démarrage (vérif immédiate, idempotent)
CATDESK_PRESS_SOURCES=latribune,cnbc,lemonde,lefigaro,france24,bbc,guardian
CATDESK_PRESS_TOPICS=             # mots-clés (recherche de caractères), séparés par des virgules
CATDESK_PRESS_SYNTHESIS=1
CATDESK_PRESS_SINCE_HOURS=24
CATDESK_PRESS_LIMIT=10            # articles max par journal
# Miroir Discord des dailys (optionnel) : chaque daily NEUVE publiée sur Supabase
# est aussi postée en embed sur ce webhook. Vide = pas de miroir. Si non renseigné
# mais DISCORD_WEBHOOK_URL l'est, ce dernier sert de repli.
CATDESK_PRESS_DISCORD_WEBHOOK=
