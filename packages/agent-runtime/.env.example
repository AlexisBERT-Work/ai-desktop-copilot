# CatDesk — agent runtime : secrets locaux (copier en `.env`, gitignoré).
# L'agent charge ce `.env` depuis son dossier (packages/agent-runtime) au démarrage.

# Webhook Discord (optionnel) — revue de presse tech / send_webhook_message
DISCORD_WEBHOOK_URL=

# ─── Revue de presse quotidienne → dailys (POSTE DE RÉFÉRENCE ADMIN UNIQUEMENT) ───
# Active la publication automatique d'une daily par journal (analyse IA
# intra-journal) + une synthèse transversale. Ne tourne QUE si CATDESK_PRESS_DIGEST=1
# ET les 4 variables admin sont renseignées ; sinon, désactivé proprement.
# Les clients (sans ces variables) ne publient jamais ; la RLS bloque de toute façon.
CATDESK_PRESS_DIGEST=0
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=

# Optionnels :
CATDESK_PRESS_MODE=both           # journal = 1 daily/journal · topic = trié par sujet · both = les deux
CATDESK_PRESS_TOPIC_LIMIT=40      # nb d'articles les plus importants soumis au tri par sujet (plafond 200)
CATDESK_PRESS_HOUR=7              # heure locale de publication (0-23)
CATDESK_PRESS_RUN_ON_START=0      # 1 = publie aussi au démarrage (vérif immédiate, idempotent)
CATDESK_PRESS_SOURCES=latribune,cnbc,lemonde,lefigaro,france24,bbc,guardian
CATDESK_PRESS_TOPICS=             # mots-clés (recherche de caractères), séparés par des virgules
CATDESK_PRESS_SYNTHESIS=1
CATDESK_PRESS_SINCE_HOURS=24
CATDESK_PRESS_LIMIT=10            # articles max par journal
